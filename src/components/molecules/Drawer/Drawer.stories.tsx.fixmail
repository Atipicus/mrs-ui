            <List>
              <ListItem sx={{ color: 'inherit' }}>Menu Item 1</ListItem>
              <ListItem sx={{ color: 'inherit' }}>Menu Item 2</ListItem>
              <ListItem sx={{ color: 'inherit' }}>Menu Item 3</ListItem>
            </List>
          </Box>
        </Drawer>
