        <IconButton onClick={() => setOpen(true)}>
          <MaterialSymbol icon="menu" />
        </IconButton>
        <Drawer anchor="left" open={open} onClose={() => setOpen(false)}>
          <Box sx={{ width: 250 }} role="presentation">
            <List>
              <ListItem>
                <HomeIcon sx={{ mr: 2 }} />
                Home
              </ListItem>
              <ListItem>
                <MaterialSymbol icon="inbox" sx={{ mr: 2 }} />
                Inbox
              </ListItem>
              <ListItem>
                <MailIcon sx={{ mr: 2 }} />
                Mail
              </ListItem>
              <ListItem>
                <SettingsIcon sx={{ mr: 2 }} />
                Settings
              </ListItem>
            </List>
          </Box>
        </Drawer>
      </Box>
    );
  },
};

