{
  "component": {
    "alert": {
      "dark": {
        "borderRadius": { "$value": "8px", "$type": "dimension" },
        "error": {
          "filled": {
            "background": { "$value": "#f48282", "$type": "color" },
            "foreground": { "$value": "#000000", "$type": "color" }
          },
          "outlined": {
            "background": { "$value": "rgba(244, 130, 130, 0.12)", "$type": "color" },
            "foreground": { "$value": "#f48282", "$type": "color" },
            "border": { "$value": "#f48282", "$type": "color" }
          },
          "standard": {
            "background": { "$value": "rgba(244, 130, 130, 0.12)", "$type": "color" },
            "foreground": { "$value": "#f48282", "$type": "color" }
          }
        },
        "warning": {
          "filled": {
            "background": { "$value": "#ffb74d", "$type": "color" },
            "foreground": { "$value": "#000000", "$type": "color" }
          },
          "outlined": {
            "background": { "$value": "rgba(255, 183, 77, 0.12)", "$type": "color" },
            "foreground": { "$value": "#ffb74d", "$type": "color" },
            "border": { "$value": "#ffb74d", "$type": "color" }
          },
          "standard": {
            "background": { "$value": "rgba(255, 183, 77, 0.12)", "$type": "color" },
            "foreground": { "$value": "#ffb74d", "$type": "color" }
          }
        },
        "info": {
          "filled": {
            "background": { "$value": "#64b5f6", "$type": "color" },
            "foreground": { "$value": "#000000", "$type": "color" }
          },
          "outlined": {
            "background": { "$value": "rgba(100, 181, 246, 0.12)", "$type": "color" },
            "foreground": { "$value": "#64b5f6", "$type": "color" },
            "border": { "$value": "#64b5f6", "$type": "color" }
          },
          "standard": {
            "background": { "$value": "rgba(100, 181, 246, 0.12)", "$type": "color" },
            "foreground": { "$value": "#64b5f6", "$type": "color" }
          }
        },
        "success": {
          "filled": {
            "background": { "$value": "#81c784", "$type": "color" },
            "foreground": { "$value": "#000000", "$type": "color" }
          },
          "outlined": {
            "background": { "$value": "rgba(129, 199, 132, 0.12)", "$type": "color" },
            "foreground": { "$value": "#81c784", "$type": "color" },
            "border": { "$value": "#81c784", "$type": "color" }
          },
          "standard": {
            "background": { "$value": "rgba(129, 199, 132, 0.12)", "$type": "color" },
            "foreground": { "$value": "#81c784", "$type": "color" }
          }
        }
      }
    }
  }
}

