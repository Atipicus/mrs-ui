{
  "semantic": {
    "color": {
      "dark": {
        "primary": {
          "main": {
            "$value": "#66b2b2",
            "$type": "color",
            "$description": "Lighter primary for dark mode"
          },
          "dark": { "$value": "{primitives.colors.brand.verones}", "$type": "color" },
          "light": { "$value": "#99cccc", "$type": "color" },
          "contrastText": { "$value": "{primitives.colors.neutral.black}", "$type": "color" }
        },
        "secondary": {
          "main": {
            "$value": "#b3e600",
            "$type": "color",
            "$description": "Lighter secondary for dark mode"
          },
          "dark": { "$value": "{primitives.colors.brand.lima}", "$type": "color" },
          "light": { "$value": "#ccff33", "$type": "color" },
          "contrastText": { "$value": "{primitives.colors.neutral.black}", "$type": "color" }
        },
        "error": {
          "main": {
            "$value": "#f48282",
            "$type": "color",
            "$description": "Lighter error for dark mode"
          },
          "dark": { "$value": "{primitives.colors.status.error.500}", "$type": "color" },
          "light": { "$value": "{primitives.colors.status.error.100}", "$type": "color" },
          "contrastText": { "$value": "{primitives.colors.neutral.black}", "$type": "color" }
        },
        "warning": {
          "main": {
            "$value": "#ffb74d",
            "$type": "color",
            "$description": "Lighter warning for dark mode"
          },
          "dark": { "$value": "{primitives.colors.status.warning.500}", "$type": "color" },
          "light": { "$value": "{primitives.colors.status.warning.50}", "$type": "color" },
          "contrastText": { "$value": "{primitives.colors.neutral.black}", "$type": "color" }
        },
        "info": {
          "main": {
            "$value": "#64b5f6",
            "$type": "color",
            "$description": "Lighter info for dark mode"
          },
          "dark": { "$value": "{primitives.colors.status.info.500}", "$type": "color" },
          "light": { "$value": "{primitives.colors.status.info.50}", "$type": "color" },
          "contrastText": { "$value": "{primitives.colors.neutral.black}", "$type": "color" }
        },
        "success": {
          "main": {
            "$value": "#81c784",
            "$type": "color",
            "$description": "Lighter success for dark mode"
          },
          "dark": { "$value": "{primitives.colors.status.success.500}", "$type": "color" },
          "light": { "$value": "{primitives.colors.status.success.50}", "$type": "color" },
          "contrastText": { "$value": "{primitives.colors.neutral.black}", "$type": "color" }
        },
        "background": {
          "default": {
            "$value": "#121212",
            "$type": "color",
            "$description": "Material Design dark background"
          },
          "paper": {
            "$value": "#1e1e1e",
            "$type": "color",
            "$description": "Elevated surface in dark mode"
          }
        },
        "text": {
          "primary": { "$value": "{primitives.colors.alpha.white.100}", "$type": "color" },
          "secondary": { "$value": "{primitives.colors.alpha.white.70}", "$type": "color" },
          "disabled": { "$value": "{primitives.colors.alpha.white.50}", "$type": "color" }
        },
        "action": {
          "active": { "$value": "{primitives.colors.alpha.white.100}", "$type": "color" },
          "hover": { "$value": "{primitives.colors.alpha.white.8}", "$type": "color" },
          "selected": { "$value": "{primitives.colors.alpha.white.16}", "$type": "color" },
          "disabled": { "$value": "{primitives.colors.alpha.white.30}", "$type": "color" },
          "disabledBackground": { "$value": "{primitives.colors.alpha.white.12}", "$type": "color" }
        },
        "divider": { "$value": "{primitives.colors.alpha.white.12}", "$type": "color" }
      }
    }
  }
}
